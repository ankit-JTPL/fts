# ==========================================
.env
.env.*
*.env
env.json
secrets.json
local_settings.py
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ==========================================
# Virtual Environments
# ==========================================
venv/
env/
ENV/
.venv/

# ==========================================
# Python & Bytecode
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Django & Local Databases
# ==========================================
*.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Migrations (keeps folder structure intact)
**/migrations/*
!**/migrations/__init__.py

